# EdunexusAI frontend environment template. Copy to `.env.local` to override.
#
# In development the Vite dev server proxies /api to the backend, so the default works
# with no configuration. Set this only when pointing the app at a different API host.
# VITE_API_BASE_URL=http://localhost:5001/api/v1

# Where the dev-server proxy forwards /api requests.
# VITE_API_PROXY_TARGET=http://localhost:5001
