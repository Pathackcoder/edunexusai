# ---------------------------------------------------------------------------
# EdunexusAI backend — production environment template (api.edunexusai.online)
# Values in <…> are secrets or per-deployment; everything else is the production setting.
# The filled-in file lives only on the server (root-only); NEVER commit it.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=5001
LOG_LEVEL=info
# Browser → Vercel (rewrite) → host nginx → API: two proxies, so req.ip is the client (per-client rate limits).
TRUST_PROXY_HOPS=2

# PostgreSQL on RDS: dedicated edunexusai database and user (never the master user). TLS verified against the RDS CA,
# mounted at /etc/ssl/rds/ca.pem. connection_limit keeps the pool small (RDS max_connections is shared).
DATABASE_URL=postgresql://edunexusai_user:<DB_PASSWORD>@edunexus-postgres.cc7y0cms2un6.us-east-1.rds.amazonaws.com:5432/edunexusai?schema=public&sslmode=require&sslcert=/etc/ssl/rds/ca.pem&sslaccept=strict&connection_limit=5

# Authentication: generate each with  openssl rand -base64 48
JWT_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# The portal. REST and university sign-in reach the API through the portal's own origin (vercel.json rewrite), so the
# sign-in callback is https://portal.edunexusai.online/api/v1/auth/oidc/callback. The chat socket connects to
# api.edunexusai.online directly, hence the portal origin in CORS_ORIGINS.
FRONTEND_URL=https://portal.edunexusai.online
CORS_ORIGINS=https://portal.edunexusai.online
OIDC_REDIRECT_BASE_URL=https://portal.edunexusai.online

# Institutional sign-in (Keycloak). The provider row (Admin > Sign-in & role mapping) names this variable.
OIDC_CLIENT_SECRET_FEDDRICK=<keycloak client "edunexusai" secret>

# ---------------------------------------------------------------------------
# CampusCore SIS (system of record; read live, never copied)
# Services on the same host are reached through their public HTTPS names: production refuses plain-http URLs.
# ---------------------------------------------------------------------------
SIS_PROVIDER=campuscore
CAMPUSCORE_BASE_URL=https://sis.edunexusai.online
CAMPUSCORE_CLIENT_ID=<CampusCore integration client id>
CAMPUSCORE_CLIENT_SECRET=<CampusCore integration client secret>
CAMPUSCORE_EXPECTED_INSTITUTION=feddrick
SIS_TENANT_KEY=demo-university
CAMPUSCORE_TIMEOUT_MS=10000
CAMPUSCORE_PORTAL_URL=https://sis.edunexusai.online
ACADEMIC_READ_MODE=synced

# ---------------------------------------------------------------------------
# Feddrick CMS (Strapi). Two tokens: reads (every page view) and changes (Studio, administrators only).
# Without CMS_MANAGE_API_TOKEN, Studio is read-only.
# ---------------------------------------------------------------------------
CMS_URL=https://cms.edunexusai.online
CMS_ADMIN_URL=https://cms.edunexusai.online/admin
CMS_API_TOKEN=<Strapi token "edunexusai-backend": read actions>
CMS_MANAGE_API_TOKEN=<Strapi token for Studio: create/update/publish/schedule/upload/delete actions>
CMS_TIMEOUT_MS=8000
CMS_LAYOUTS_ENABLED=true

# ---------------------------------------------------------------------------
# Campus directory from Keycloak (Admin REST API, read-only service account)
# ---------------------------------------------------------------------------
KEYCLOAK_DIRECTORY_BASE_URL=https://auth.edunexusai.online
KEYCLOAK_DIRECTORY_REALM=edunexusai-feddrick
KEYCLOAK_DIRECTORY_CLIENT_ID=edunexusai-directory
KEYCLOAK_DIRECTORY_CLIENT_SECRET=<keycloak client "edunexusai-directory" secret>
KEYCLOAK_DIRECTORY_TENANT=demo-university
KEYCLOAK_DIRECTORY_PROVIDER_KEY=feddrick-sso
KEYCLOAK_DIRECTORY_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Moodle LMS (MoodleCloud). Token of a web-service user; backend-only.
# Writes (course shells, LMS accounts, enrolments) stay off until reviewed for production.
# ---------------------------------------------------------------------------
MOODLE_BASE_URL=<https://<site>.moodlecloud.com>
MOODLE_TOKEN=<Moodle web-service token>
MOODLE_WRITES_ENABLED=false
MOODLE_JIT_PROVISIONING=false
MOODLE_STUDENT_ROLE_ID=5
MOODLE_TEACHER_ROLE_ID=3
MOODLE_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Outgoing mail (Studio form notifications). Nothing is sent unless SMTP_HOST (or SMTP_URL) and MAIL_FROM are set.
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# FORM_RECIPIENT_DOMAINS=feddrick.edu

# Branding uploads (persistent volume)
BRANDING_STORAGE_DIR=/app/storage/branding
