# ---------------------------------------------------------------------------
# EdunexusAI Backend — production environment template
# All values are placeholders. Replace <…> tokens before deployment.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=5001
LOG_LEVEL=combined

# PostgreSQL on RDS (dedicated edunexusai database)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@edunexus-postgres.cc7y0cms2un6.us-east-1.rds.amazonaws.com:5432/edunexusai?schema=public&sslmode=require"

# Authentication — generate each: openssl rand -base64 48
JWT_SECRET=<generate-random-64-chars>
JWT_REFRESH_SECRET=<generate-different-random-64-chars>
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# CORS — the production frontend origin (Vercel or custom domain)
FRONTEND_URL=https://<FRONTEND_DOMAIN>
CORS_ORIGINS=https://<FRONTEND_DOMAIN>

# OIDC redirect base (the origin the browser sees when signing in via SSO)
OIDC_REDIRECT_BASE_URL=https://<FRONTEND_DOMAIN>

# ---------------------------------------------------------------------------
# CampusCore SIS
# ---------------------------------------------------------------------------
SIS_PROVIDER=campuscore
# Docker-internal: CampusCore runs on the same host, reached via Docker network
CAMPUSCORE_BASE_URL=http://campuscore:4000
CAMPUSCORE_CLIENT_ID=<from-campuscore-seed-output>
CAMPUSCORE_CLIENT_SECRET=<from-campuscore-seed-output>
CAMPUSCORE_EXPECTED_INSTITUTION=feddrick
SIS_TENANT_KEY=demo-university
CAMPUSCORE_TIMEOUT_MS=10000

# CampusCore portal URL (shown in the UI as "Open CampusCore SIS")
# CAMPUSCORE_PORTAL_URL=https://<CAMPUSCORE_DOMAIN>

# ---------------------------------------------------------------------------
# Feddrick CMS (Strapi)
# ---------------------------------------------------------------------------
# Docker-internal: Strapi runs on the same host
CMS_URL=http://strapi:1337
CMS_ADMIN_URL=https://<CMS_DOMAIN>/admin
CMS_API_TOKEN=<from-strapi-admin-panel>
CMS_TIMEOUT_MS=8000
CMS_LAYOUTS_ENABLED=false

# ---------------------------------------------------------------------------
# Keycloak Campus Directory (Admin REST API, read-only)
# ---------------------------------------------------------------------------
# Docker-internal: Keycloak runs on the same host
KEYCLOAK_DIRECTORY_BASE_URL=http://keycloak:8080
KEYCLOAK_DIRECTORY_REALM=edunexusai-feddrick
KEYCLOAK_DIRECTORY_CLIENT_ID=edunexusai-directory
KEYCLOAK_DIRECTORY_CLIENT_SECRET=<from-keycloak-client-credentials>
KEYCLOAK_DIRECTORY_TENANT=demo-university
# KEYCLOAK_DIRECTORY_PROVIDER_KEY=feddrick-sso
KEYCLOAK_DIRECTORY_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# OIDC client secret for institutional sign-in (Keycloak)
# ---------------------------------------------------------------------------
# The provider row in Admin > Sign-in & role mapping references this by name.
OIDC_CLIENT_SECRET_FEDDRICK=<from-keycloak-edunexusai-client-credentials>

# ---------------------------------------------------------------------------
# Moodle LMS (optional)
# ---------------------------------------------------------------------------
# MOODLE_BASE_URL=https://<your-moodle-site>
# MOODLE_TOKEN=<moodle-web-service-token>
# MOODLE_WRITES_ENABLED=false
# MOODLE_STUDENT_ROLE_ID=
# MOODLE_TEACHER_ROLE_ID=
# MOODLE_DEFAULT_CATEGORY_ID=
# MOODLE_SITE_USER_QUOTA=

# ---------------------------------------------------------------------------
# SMTP (optional)
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="EduNexusAI Forms <no-reply@<DOMAIN>>"

# Branding uploads directory (Docker volume)
BRANDING_STORAGE_DIR=/app/storage/branding
