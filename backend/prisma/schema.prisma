  title           String
  message         String
  category        String
  priority        String    @default("normal")
  audienceType    String
  audienceValue   String?
  audienceLabel   String
  channels        String[]
  /// DRAFT | SCHEDULED | SENT
  status          String    @default("DRAFT")
