}

// ===========================================================================
// Cross-persona workflows
//
// One request architecture for every "someone asks, an administrator decides" flow.
// Domain-specific records (ProfileChangeRequest, TranscriptRequest, FormSubmission)
// keep their own tables; a ServiceRequest row links to them through
// sourceType/sourceId so the Admin Operations Workspace sees a single queue and a
// decision is applied back to the domain record in one place (requestService.js).
// ===========================================================================

enum ServiceRequestStatus {
  PENDING
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model ServiceRequest {
  id              String               @id @default(uuid())
  tenantId        String
  reference       String
  requesterUserId String
  requesterRole   RoleKey
  type            String
  category        String
  title           String
  description     String?
  details         Json?
  priority        String               @default("NORMAL")
  status          ServiceRequestStatus @default(PENDING)
  /// Link to a domain record the decision is applied to (PROFILE_CHANGE, TRANSCRIPT, ...).
  sourceType      String?
  sourceId        String?
  decisionNote    String?
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester User                  @relation("RequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  decidedBy User?                 @relation("RequestDecider", fields: [decidedByUserId], references: [id])
  events    ServiceRequestEvent[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([requesterUserId])
  @@index([sourceType, sourceId])
  @@map("service_requests")
}

model ServiceRequestEvent {
  id          String                @id @default(uuid())
  requestId   String
  actorUserId String?
  action      String
  fromStatus  ServiceRequestStatus?
  toStatus    ServiceRequestStatus?
  note        String?
  createdAt   DateTime              @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorUserId], references: [id])

  @@index([requestId, createdAt])
  @@map("service_request_events")
}

