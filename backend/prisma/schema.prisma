/// Portal-level follow-up flag. Entered by faculty/advisors or imported from a source
/// system; never a computed risk score.
model StudentIntervention {
  id               String    @id @default(uuid())
  tenantId         String
  studentProfileId String?
  /// Free-text subject when the follow-up is not about one student (a group, a task).
  subjectLabel     String?
  courseId         String?
  createdByUserId  String?
  /// TASK | ATTENDANCE | MISSING_WORK | ACADEMIC_CONCERN | FOLLOW_UP | ADVISING | REFERRAL
  type             String
  title            String
  note             String?
  /// OPEN | IN_PROGRESS | RESOLVED
  status           String    @default("OPEN")
  dueDate          DateTime? @db.Date
