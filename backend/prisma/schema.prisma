// EdunexusAI — canonical data model
//
// Design notes
//  * Every tenant-owned table carries `tenantId`. Tenant isolation is enforced in the
//    service layer via the request's tenant context (see src/middleware/tenant.js).
//    A future schema-per-institution model stays possible because no query assumes a
//    single global dataset. See docs/decisions.md (ADR-002).
//  * Columns that the UI renders verbatim (statuses such as "Accepted & Disbursed",
//    "Dean's Honor List") are stored as String so the existing screens keep their exact
//    wording. Enums are reserved for values the backend branches on.
//  * Integration-sourced rows carry `sourceSystem` / `externalId` / `lastSyncedAt` so the
//    provenance of a record such as "CS 501" is visible in the database itself.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleKey {
  STUDENT
  FACULTY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum ProfileChangeType {
  ADDRESS
  NAME
}

enum ProfileChangeStatus {
  PENDING
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
}

enum IntegrationProvider {
  MOCK_UNIVERSITY
  CANVAS
  BANNER
  ETHOS
  WORKDAY
}

enum IntegrationMode {
  MOCK
  LIVE
  DISABLED
}

enum IntegrationStatus {
  NOT_CONFIGURED
  NOT_CONNECTED
  CONNECTED
  DEGRADED
  ERROR
}

enum IntegrationAuthType {
  NONE
  API_KEY
  BEARER_TOKEN
  OAUTH2_CLIENT_CREDENTIALS
  BASIC
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum SourceSystem {
  EDUNEXUS
  MOCK_UNIVERSITY
  CANVAS
  BANNER
  ETHOS
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  shortName String?
  domain    String?
  timezone  String   @default("America/New_York")
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  studentTiers            StudentTier[]
  widgetEntitlements      WidgetEntitlement[]
  roleWidgetEntitlements  RoleWidgetEntitlement[]
  terms                   Term[]
  courses                 Course[]
  enrollments             Enrollment[]
  assignments             Assignment[]
  submissions             AssignmentSubmission[]
  announcements           Announcement[]
  academicEvents          AcademicEvent[]
  notifications           Notification[]
  tuitionAccounts         TuitionAccount[]
  payments                Payment[]
  financialAidPackages    FinancialAidPackage[]
  transcriptTerms         TranscriptTerm[]
  transcriptRequests      TranscriptRequest[]
  directoryProfiles       DirectoryProfile[]
  libraryAccounts         LibraryAccount[]
  libraryCatalogItems     LibraryCatalogItem[]
  securityContacts        SecurityContact[]
  emergencyProcedures     EmergencyProcedure[]
  safetySettings          CampusSafetySetting[]
  faqCategories           FaqCategory[]
  faqItems                FaqItem[]
  supportContacts         SupportContact[]
  communicationCategories CommunicationCategory[]
  communicationPrefs      CommunicationPreference[]
  profileChangeRequests   ProfileChangeRequest[]
  integrations            Integration[]
  integrationSyncLogs     IntegrationSyncLog[]
  externalIdentities      ExternalIdentity[]
  serviceRequests         ServiceRequest[]
  supportTickets          SupportTicket[]
  portalForms             PortalForm[]
  formSubmissions         FormSubmission[]
  portalResources         PortalResource[]
  broadcasts              CommunicationBroadcast[]
  auditLogs               AuditLog[]
  attachments             Attachment[]
  dashboardLayouts        DashboardLayout[]
  interventions           StudentIntervention[]
  advisingSlots           AdvisingSlot[]
  advisingAppointments    AdvisingAppointment[]
  careerOpportunities     CareerOpportunity[]
  portfolioItems          PortfolioItem[]
  studentGroups           StudentGroup[]
  calendarConnections     CalendarConnection[]
  learningPaths           LearningPath[]
  degreeRequirements      DegreeRequirement[]
  catalogCourses          CatalogCourse[]
  campusBuildings         CampusBuilding[]
  assistantMessages       AssistantMessage[]
  studentProfiles         StudentProfile[]
  facultyProfiles         FacultyProfile[]
  staffProfiles           StaffProfile[]

  @@map("tenants")
}

model Role {
  id          String   @id @default(uuid())
  key         RoleKey  @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  locale       String     @default("en")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userRoles             UserRole[]
  studentProfile        StudentProfile?
  facultyProfile        FacultyProfile?
  staffProfile          StaffProfile?
  directoryProfile      DirectoryProfile?
  notifications         Notification[]            @relation("NotificationRecipient")
  createdNotifications  Notification[]            @relation("NotificationCreator")
  announcements         Announcement[]
  announcementReads     AnnouncementRead[]
  communicationPrefs    CommunicationPreference[]
  profileChangeRequests ProfileChangeRequest[]
  triggeredSyncs        IntegrationSyncLog[]
  refreshTokens         RefreshToken[]
  instructedCourses     Course[]                  @relation("CourseInstructor")

  serviceRequests      ServiceRequest[]         @relation("RequestRequester")
  decidedRequests      ServiceRequest[]         @relation("RequestDecider")
  requestEvents        ServiceRequestEvent[]
  supportTickets       SupportTicket[]          @relation("TicketRequester")
  assignedTickets      SupportTicket[]          @relation("TicketAssignee")
  ticketMessages       SupportTicketMessage[]
  createdForms         PortalForm[]
  formSubmissions      FormSubmission[]         @relation("FormSubmitter")
  reviewedSubmissions  FormSubmission[]         @relation("FormReviewer")
  resources            PortalResource[]
  broadcasts           CommunicationBroadcast[]
  auditLogs            AuditLog[]
  attachments          Attachment[]
  dashboardLayouts     DashboardLayout[]
  interventionsCreated StudentIntervention[]    @relation("InterventionCreator")
  advisingSlots        AdvisingSlot[]
  advisingAsStudent    AdvisingAppointment[]    @relation("AppointmentStudent")
  advisingAsAdvisor    AdvisingAppointment[]    @relation("AppointmentAdvisor")
  savedOpportunities   SavedOpportunity[]
  portfolioItems       PortfolioItem[]
  groupMemberships     GroupMembership[]
  calendarConnections  CalendarConnection[]
  learningPaths        UserLearningPath[]
  learningStepProgress LearningStepProgress[]
  assistantMessages    AssistantMessage[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Entitlements — tier-driven, configuration-not-code widget visibility
// ---------------------------------------------------------------------------

model WidgetDefinition {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String?
  category    String
  route       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  entitlements WidgetEntitlement[]

  @@map("widget_definitions")
}

model StudentTier {
  id          String   @id @default(uuid())
  tenantId    String
  key         String
  name        String
  description String?
  rank        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entitlements WidgetEntitlement[]
  students     StudentProfile[]

  @@unique([tenantId, key])
  @@map("student_tiers")
}

model WidgetEntitlement {
  id        String   @id @default(uuid())
  tenantId  String
  tierId    String
  widgetId  String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier   StudentTier      @relation(fields: [tierId], references: [id], onDelete: Cascade)
  widget WidgetDefinition @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([tierId, widgetId])
  @@index([tenantId])
  @@map("widget_entitlements")
}

// ---------------------------------------------------------------------------
// Persona profiles
// ---------------------------------------------------------------------------

model StudentProfile {
  id                   String   @id @default(uuid())
  tenantId             String
  userId               String   @unique
  tierId               String?
  studentNumber        String
  preferredName        String?
  pronouns             String?
  pronounsVisibility   String   @default("Faculty & Advisors Only")
  directoryVisible     Boolean  @default(true)
  degree               String?
  department           String?
  academicStanding     String?
  admitTerm            String?
  currentTerm          String?
  creditsCompleted     Int      @default(0)
  totalCreditsRequired Int      @default(0)
  cumulativeGpa        Decimal? @db.Decimal(3, 2)
  majorGpa             Decimal? @db.Decimal(3, 2)
  semesterGpa          Decimal? @db.Decimal(3, 2)
  honors               String?
  interests            String[]
  careerGoals          String[]
  addressLine1         String?
  city                 String?
  state                String?
  postalCode           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier   StudentTier? @relation(fields: [tierId], references: [id])

  emergencyContacts    EmergencyContact[]
  enrollments          Enrollment[]
  submissions          AssignmentSubmission[]
  tuitionAccount       TuitionAccount?
  financialAidPackages FinancialAidPackage[]
  transcriptTerms      TranscriptTerm[]
  transcriptRequests   TranscriptRequest[]
  libraryAccount       LibraryAccount?
  interventions        StudentIntervention[]

  @@unique([tenantId, studentNumber])
  @@index([tenantId])
  @@map("student_profiles")
}

model EmergencyContact {
  id               String   @id @default(uuid())
  studentProfileId String
  name             String
  relationship     String?
  phone            String?
  altPhone         String?
  email            String?
  isPrimary        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("emergency_contacts")
}

model FacultyProfile {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String   @unique
  employeeNumber String
  title          String?
  department     String?
  officeLocation String?
  officeHours    String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@map("faculty_profiles")
}

model StaffProfile {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String   @unique
  employeeNumber String
  title          String?
  department     String?
  officeLocation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@map("staff_profiles")
}

// ---------------------------------------------------------------------------
// Academics
//
// Course / Enrollment / Assignment / grade rows are INTEGRATION-OWNED. They are
// written by the integration layer (connector -> canonical mapper -> upsert) and
// carry their provenance. Edunexus owns the overlay rows (submissions, reads).
// ---------------------------------------------------------------------------

model Term {
  id        String    @id @default(uuid())
  tenantId  String
  code      String
  name      String
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([tenantId, code])
  @@map("terms")
}

model Course {
  id               String       @id @default(uuid())
  tenantId         String
  termId           String
  code             String
  name             String
  credits          Int          @default(0)
  description      String?
  room             String?
  meetingDays      String[]
  dayCodes         String[]
  timeLabel        String?
  startTime        String?
  endTime          String?
  colorHex         String?
  bgColorHex       String?
  borderColorHex   String?
  syllabusUrl      String?
  instructorUserId String?
  instructorName   String?
  instructorEmail  String?
  officeHours      String?
  lmsUrl           String?
  sourceSystem     SourceSystem @default(EDUNEXUS)
  externalId       String?
  lastSyncedAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term       Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  instructor User?  @relation("CourseInstructor", fields: [instructorUserId], references: [id])

  enrollments   Enrollment[]
  assignments   Assignment[]
  announcements Announcement[]

  @@unique([tenantId, termId, code])
  @@index([tenantId])
  @@index([sourceSystem, externalId])
  @@map("courses")
}

model Enrollment {
  id               String       @id @default(uuid())
  tenantId         String
  courseId         String
  studentProfileId String
  status           String       @default("Enrolled")
  letterGrade      String?
  percentage       Decimal?     @db.Decimal(5, 2)
  gradePoints      Decimal?     @db.Decimal(3, 2)
  enrolledAt       DateTime     @default(now())
  sourceSystem     SourceSystem @default(EDUNEXUS)
  externalId       String?
  lastSyncedAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  gradeComponents GradeComponent[]

  @@unique([courseId, studentProfileId])
  @@index([tenantId])
  @@index([studentProfileId])
  @@map("enrollments")
}

/// Per-course grade breakdown rows ("assignments 96%", "midterm 94%").
/// Relational instead of a JSON blob so the breakdown stays queryable.
model GradeComponent {
  id           String   @id @default(uuid())
  enrollmentId String
  label        String
  displayKey   String
  scoreLabel   String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("grade_components")
}

model Assignment {
  id             String       @id @default(uuid())
  tenantId       String
  courseId       String
  title          String
  description    String?
  dueDate        DateTime
  dueTimeLabel   String?
  points         Int          @default(0)
  submissionType String?
  weightLabel    String?
  sourceSystem   SourceSystem @default(EDUNEXUS)
  externalId     String?
  lastSyncedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]

  @@index([tenantId])
  @@index([courseId])
  @@index([sourceSystem, externalId])
  @@map("assignments")
}

/// Edunexus-owned overlay on integration-owned assignments: the student's own state.
model AssignmentSubmission {
  id               String    @id @default(uuid())
  tenantId         String
  assignmentId     String
  studentProfileId String
  status           String    @default("Pending")
  submittedAt      DateTime?
  score            Int?
  submissionNote   String?
  submissionRef    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment     Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentProfileId])
  @@index([tenantId])
  @@map("assignment_submissions")
}

model Announcement {
  id           String   @id @default(uuid())
  tenantId     String
  courseId     String?
  authorUserId String?
  authorName   String
  title        String
  content      String
  tags         String[]
  audience     String   @default("COURSE")
  postedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User?   @relation(fields: [authorUserId], references: [id])

  reads AnnouncementRead[]

  @@index([tenantId])
  @@index([courseId])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

model AcademicEvent {
  id          String   @id @default(uuid())
  tenantId    String
  externalKey String
  title       String
  eventDate   DateTime @db.Date
  startTime   String?
  endTime     String?
  category    String
  location    String?
  description String?
  isImportant Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalKey])
  @@index([tenantId, eventDate])
  @@map("academic_events")
}

// ---------------------------------------------------------------------------
// Transcripts
// ---------------------------------------------------------------------------

model TranscriptTerm {
  id                 String   @id @default(uuid())
  tenantId           String
  studentProfileId   String
  termLabel          String
  level              String   @default("Graduate")
  termGpaLabel       String?
  termGpa            Decimal? @db.Decimal(3, 2)
  cumulativeGpa      Decimal? @db.Decimal(3, 2)
  creditsAttempted   Int      @default(0)
  creditsEarnedLabel String?
  creditsEarned      Int?
  academicStanding   String?
  isInProgress       Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  courses TranscriptCourse[]

  @@unique([studentProfileId, termLabel])
  @@index([tenantId])
  @@map("transcript_terms")
}

model TranscriptCourse {
  id               String   @id @default(uuid())
  transcriptTermId String
  code             String
  title            String
  credits          Int      @default(0)
  grade            String
  pointsLabel      String?
  points           Decimal? @db.Decimal(3, 2)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  transcriptTerm TranscriptTerm @relation(fields: [transcriptTermId], references: [id], onDelete: Cascade)

  @@index([transcriptTermId])
  @@map("transcript_courses")
}

model TranscriptRequest {
  id               String   @id @default(uuid())
  tenantId         String
  studentProfileId String
  reference        String
  requestDate      DateTime @default(now())
  deliveryType     String
  recipient        String
  recipientEmail   String?
  recipientAddress String?
  copies           Int      @default(1)
  status           String   @default("Submitted")
  feeLabel         String   @default("$0.00 (Student Waiver)")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([studentProfileId])
  @@map("transcript_requests")
}

// ---------------------------------------------------------------------------
// Finance & financial aid
// ---------------------------------------------------------------------------

model TuitionAccount {
  id               String   @id @default(uuid())
  tenantId         String
  studentProfileId String   @unique
  academicYear     String
  termLabel        String
  currentBalance   Decimal  @db.Decimal(12, 2)
  openingBalance   Decimal  @db.Decimal(12, 2)
  dueDate          DateTime @db.Date
  statusLabel      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  charges  TuitionCharge[]
  payments Payment[]

  @@index([tenantId])
  @@map("tuition_accounts")
}

model TuitionCharge {
  id               String   @id @default(uuid())
  tuitionAccountId String
  label            String
  amount           Decimal  @db.Decimal(12, 2)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  tuitionAccount TuitionAccount @relation(fields: [tuitionAccountId], references: [id], onDelete: Cascade)

  @@index([tuitionAccountId])
  @@map("tuition_charges")
}

model Payment {
  id               String   @id @default(uuid())
  tenantId         String
  tuitionAccountId String
  reference        String
  receiptNumber    String
  transactionRef   String
  description      String
  amount           Decimal  @db.Decimal(12, 2)
  paymentMethod    String
  status           String   @default("Completed")
  type             String   @default("Payment")
  paidAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tuitionAccount TuitionAccount @relation(fields: [tuitionAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([tuitionAccountId])
  @@map("payments")
}

model FinancialAidPackage {
  id                String       @id @default(uuid())
  tenantId          String
  studentProfileId  String
  awardYear         String
  status            String
  applicationStatus String
  totalAwarded      Decimal      @db.Decimal(12, 2)
  disbursed         Decimal      @db.Decimal(12, 2)
  scheduled         Decimal      @db.Decimal(12, 2)
  lastUpdatedLabel  String?
  sourceSystem      SourceSystem @default(EDUNEXUS)
  externalId        String?
  lastSyncedAt      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  awards        FinancialAidAward[]
  disbursements AidDisbursement[]
  requirements  AidRequirement[]

  @@unique([studentProfileId, awardYear])
  @@index([tenantId])
  @@map("financial_aid_packages")
}

model FinancialAidAward {
  id             String   @id @default(uuid())
  packageId      String
  reference      String
  name           String
  category       String
  amount         Decimal  @db.Decimal(12, 2)
  termLabel      String?
  status         String
  renewableLabel String?
  description    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  package FinancialAidPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, reference])
  @@index([packageId])
  @@map("financial_aid_awards")
}

model AidDisbursement {
  id          String   @id @default(uuid())
  packageId   String
  disbursedOn DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  status      String
  appliedTo   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  package FinancialAidPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("aid_disbursements")
}

