  tenantId      String
  code          String
  title         String
  credits       Int      @default(4)
  department    String?
  level         String?
  description   String?
  topics        String[]
  careerTags    String[]
  prerequisites String[]
  termsOffered  String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("catalog_courses")
}

model DegreeRequirement {
  id              String   @id @default(uuid())
  tenantId        String
  program         String
  category        String
  title           String
  description     String?
  creditsRequired Int
  /// Course codes that satisfy this requirement. Empty = any course not used elsewhere.
  courseCodes     String[]
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, program, category])
  @@map("degree_requirements")
}

model LearningPath {
  id          String   @id @default(uuid())
  tenantId    String
  key         String
  title       String
  description String?
  careerGoal  String?
  program     String?
  createdAt   DateTime @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       LearningPathStep[]
  enrollments UserLearningPath[]

  @@unique([tenantId, key])
  @@map("learning_paths")
}

model LearningPathStep {
  id             String  @id @default(uuid())
  pathId         String
  sortOrder      Int
  stage          String
  title          String
  /// COURSE | RESOURCE | SKILL | MILESTONE
  kind           String
  description    String?
  courseCode     String?
  resourceUrl    String?
  estimatedHours Int?

  path     LearningPath           @relation(fields: [pathId], references: [id], onDelete: Cascade)
  progress LearningStepProgress[]

  @@unique([pathId, sortOrder])
  @@map("learning_path_steps")
}

model UserLearningPath {
  id        String   @id @default(uuid())
  userId    String
  pathId    String
  isActive  Boolean  @default(true)
  startedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
  @@map("user_learning_paths")
}

model LearningStepProgress {
  id          String    @id @default(uuid())
  userId      String
  stepId      String
  /// IN_PROGRESS | COMPLETED
  status      String
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  step LearningPathStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@map("learning_step_progress")
}

// ===========================================================================
// Career & community
// ===========================================================================

model CareerOpportunity {
  id           String    @id @default(uuid())
  tenantId     String
  externalKey  String
  type         String
  title        String
  company      String
  location     String
  workMode     String
  field        String
  skills       String[]
  description  String
  compensation String?
  deadline     DateTime? @db.Date
  applyUrl     String?
  postedAt     DateTime  @default(now())
  sourceSystem String    @default("CAREER_SERVICES_MOCK")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saves  SavedOpportunity[]

  @@unique([tenantId, externalKey])
  @@index([tenantId, type])
  @@map("career_opportunities")
}

model SavedOpportunity {
  id            String   @id @default(uuid())
  userId        String
  opportunityId String
  /// SAVED | APPLIED
  status        String   @default("SAVED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@map("saved_opportunities")
}

model PortfolioItem {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  /// SKILL | PROJECT | EXPERIENCE | ACHIEVEMENT
  kind        String
  title       String
  subtitle    String?
  description String?
  level       Int?
  tags        String[]
  url         String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("portfolio_items")
}

model StudentGroup {
  id          String   @id @default(uuid())
  tenantId    String
  slug        String
  name        String
  category    String
  description String
  meetingInfo String?
  location    String?
  advisorName String?
  colorHex    String?
  /// Open groups accept members immediately; others need an officer's approval.
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  events      GroupEvent[]

  @@unique([tenantId, slug])
  @@map("student_groups")
}

model GroupMembership {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  /// MEMBER | OFFICER | LEAD
  role     String   @default("MEMBER")
  /// ACTIVE | PENDING
  status   String   @default("ACTIVE")
  joinedAt DateTime @default(now())

  group StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_memberships")
}

model GroupEvent {
  id          String   @id @default(uuid())
  groupId     String
  title       String
  description String?
  startsAt    DateTime
  location    String?
  createdAt   DateTime @default(now())

  group StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, startsAt])
  @@map("group_events")
}

// ===========================================================================
// Campus
// ===========================================================================

model CampusBuilding {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  category    String
  description String?
  address     String?
  hours       String?
  amenities   String[]
  /// Position on the stylised campus map, 0-100 on each axis.
  mapX        Int
  mapY        Int
  createdAt   DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classrooms Classroom[]

  @@unique([tenantId, code])
  @@map("campus_buildings")
}

model Classroom {
  id         String   @id @default(uuid())
  buildingId String
  roomNumber String
  name       String
  capacity   Int
  roomType   String
  features   String[]

  building CampusBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, roomNumber])
  @@map("classrooms")
}

/// External calendar link (Google / Outlook). Prototype: the connection is simulated by
/// a mock adapter; no OAuth tokens are stored.
model CalendarConnection {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String
  provider     String
  /// CONNECTED | DISCONNECTED
  status       String    @default("CONNECTED")
  accountEmail String?
  lastSyncedAt DateTime?
  eventsSynced Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("calendar_connections")
}

model AssistantMessage {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  /// user | assistant
  role      String
  content   String
  /// Suggested follow-up actions returned with an assistant turn.
  actions   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("assistant_messages")
}
