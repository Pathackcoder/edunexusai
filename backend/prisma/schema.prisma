model Integration {
  id                   String              @id @default(uuid())
  tenantId             String
  key                  String
  provider             IntegrationProvider
  displayName          String
  description          String?
  mode                 IntegrationMode     @default(MOCK)
  baseUrl              String?
  apiVersion           String?
  authType             IntegrationAuthType @default(NONE)
  /// Name of the backend environment variable holding the secret.
  /// The secret value itself is never stored here and never leaves the backend.
  credentialRef        String?
  enabled              Boolean             @default(true)
  timeoutMs            Int                 @default(8000)
  supportedDomains     String[]
  status               IntegrationStatus   @default(NOT_CONFIGURED)
  lastAttemptAt        DateTime?
  lastSuccessfulSyncAt DateTime?
  lastErrorMessage     String?
  lastResponseTimeMs   Int?
  lastRecordCount      Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncLogs   IntegrationSyncLog[]
  operations IntegrationOperation[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("integrations")
}

model IntegrationSyncLog {
  id                String     @id @default(uuid())
  tenantId          String
  integrationId     String
  operation         String
  status            SyncStatus
  startedAt         DateTime   @default(now())
  completedAt       DateTime?
  durationMs        Int?
  recordsProcessed  Int        @default(0)
  errorMessage      String?
  /// What actually happened: RECORDS, EMPTY, NOT_IMPLEMENTED, NOT_SUPPORTED,
  /// FUNCTION_NOT_ENABLED, PERMISSION_DENIED, AUTH_FAILED, NETWORK, PARTIAL, ERROR.
  outcome           String?
  triggeredByUserId String?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  triggeredBy User?       @relation(fields: [triggeredByUserId], references: [id])

  @@index([integrationId, startedAt])
  @@index([tenantId])
  @@map("integration_sync_logs")
}

/// Canonical-identity mapping. Keeps provider-specific identifiers
/// (bannerStudentId, canvasUserId, externalCourseId) out of the domain models
/// and out of every API response.
model ExternalIdentity {
  id                  String              @id @default(uuid())
  tenantId            String
  provider            IntegrationProvider
  entityType          String
  externalId          String
  internalId          String
  /// Set (to internalId) only for one-to-one links such as a Moodle user or course, so
  /// one local record can never be linked to two external records. Left null for
  /// many-to-one sync mappings, which keep their existing behaviour.
  exclusiveInternalId String?
  /// ACTIVE | SUSPENDED (external account suspended; link and history preserved)
  status              String              @default("ACTIVE")
  /// How the link was established: PROVISIONED, VERIFIED_EMAIL, IDNUMBER_MATCH, SYNC
  linkMethod          String?
  linkedByUserId      String?
  verifiedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, entityType, externalId])
  @@unique([tenantId, provider, entityType, exclusiveInternalId])
  @@index([tenantId, entityType, internalId])
  @@map("external_identities")
}

/// One cross-system write (create a Moodle user, enrol a student...). PostgreSQL and the
/// external system share no transaction, so each step is recorded and observable:
/// PENDING -> SUCCEEDED | FAILED | NEEDS_RECONCILIATION | BLOCKED. A retry re-runs the
/// same handler, which always looks the object up in the external system before
/// creating it, so an uncertain earlier attempt never produces a duplicate.
model IntegrationOperation {
  id                String    @id @default(uuid())
  tenantId          String
  integrationId     String
  /// e.g. USER.PROVISION, COURSE.CREATE, ENROLMENT.ADD, USER.SUSPEND
  operation         String
  /// Stable key for the intent, e.g. USER.PROVISION:<studentProfileId>
  idempotencyKey    String
  status            String    @default("PENDING")
  entityType        String
  internalId        String?
  externalId        String?
  /// Non-secret request parameters needed to retry. Never passwords or tokens.
  request           Json?
  result            Json?
  errorKind         String?
  errorMessage      String?
  attempts          Int       @default(0)
  correlationId     String
  triggeredByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([integrationId, createdAt])
  @@map("integration_operations")
}

// Role-level dashboard visibility. Student entitlements remain tier-driven.
model RoleWidgetEntitlement {
  tenantId  String
  roleKey   String
  widgetKey String
  enabled   Boolean @default(true)
