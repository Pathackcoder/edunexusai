/// Which Moodle course delivers a CampusCore section (the LMS side of a registered class).
/// Owned by EduNexusAI as integration configuration; holds only the two systems' stable ids.
/// Many sections may share one Moodle course; a section has at most one. A section with no
/// row has no Moodle course, which is a valid state (not every class uses the LMS).
model SisSectionMoodleCourse {
  id             String   @id @default(uuid())
  tenantId       String
  sisSectionId   String
  sisTermId      String
  moodleCourseId Int
  linkedByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sisSectionId])
  @@index([tenantId, moodleCourseId])
  @@index([tenantId, sisTermId])
  @@map("sis_section_moodle_courses")
}

/// An institution's sign-in identity provider (OpenID Connect: Keycloak or the university's own).
/// The client secret is never stored: `clientSecretEnv` names the server environment variable that
/// holds it. Disabled by default; a provider only ever serves its own tenant.
model IdentityProvider {
  id                         String   @id @default(uuid())
  tenantId                   String
  /// URL-safe key used in sign-in links, unique per tenant (e.g. "feddrick-sso").
  key                        String
  displayName                String
  issuer                     String
  clientId                   String
  clientSecretEnv            String?
  scopes                     String   @default("openid email profile")
  /// Dotted claim path of the institutional student number / employee number in the ID token.
  studentIdClaim             String?
  employeeIdClaim            String?
  /// Institutional policy: the provider's employee number establishes a staff record.
  employeeIdEstablishesStaff Boolean  @default(false)
  /// SSO-first: at the first sign-in of someone with no portal account, create it from the CampusCore person
  /// behind the token's verified institutional numbers (one person, a current relationship, the person's email).
  jitProvisioning            Boolean  @default(false)
  enabled                    Boolean  @default(false)
  /// Development only (an http issuer such as a local Keycloak); refused in production.
  allowInsecureHttp          Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleMappings        IdentityRoleMapping[]
  federatedIdentities FederatedIdentity[]
  roleSources         RoleAssignmentSource[]
  ssoSessions         SsoSession[]

  @@unique([tenantId, key])
  @@map("identity_providers")
}

/// Institution-specific rule: a value of one claim (roles, groups, affiliation) is EVIDENCE for one
/// EdunexusAI community role. Administrative roles can never be a target (also a CHECK constraint).
model IdentityRoleMapping {
  id              String   @id @default(uuid())
  tenantId        String
  providerId      String
  /// Dotted claim path, e.g. "realm_access.roles", "groups", "eduPersonAffiliation".
  claim           String
  externalValue   String
  targetRole      RoleKey
  enabled         Boolean  @default(true)
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, claim, externalValue, targetRole])
  @@index([tenantId])
  @@map("identity_role_mappings")
}

/// The stable link between an EdunexusAI account and an external identity (issuer + subject).
model FederatedIdentity {
  id             String    @id @default(uuid())
  tenantId       String
  userId         String
  providerId     String
  issuer         String
  subject        String
  emailAtLink    String?
  /// INSTITUTIONAL_ID (verified institutional numbers) or ADMIN (linked by an administrator)
  linkMethod     String
  linkedAt       DateTime  @default(now())
  lastLoginAt    DateTime?
  /// The last sign-in's role evaluation: mapped, granted, withheld (with reasons) and unknown values.
  lastEvaluation Json?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@unique([providerId, userId])
  @@index([userId])
  @@map("federated_identities")
}

/// Why a role is held. `user_roles` says WHICH roles a person holds; each row here is one source of
/// one of them: EXISTING (held before provenance was recorded), MANUAL (assigned by an
/// administrator), SIS (established from a verified SIS record link), IDP (asserted by an identity
/// provider under the institution's mapping rules). A sign-in removes only its own IDP sources, and
/// removes the role itself only when that grant created it and no other source remains.
model RoleAssignmentSource {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String
  roleKey         RoleKey
  source          String
  /// source, or "IDP:<providerId>": one row per role and source.
  sourceKey       String
  providerId      String?
  grantedByUserId String?
  createdRole     Boolean  @default(false)
  evidence        Json?
  createdAt       DateTime @default(now())
  confirmedAt     DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider IdentityProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, roleKey, sourceKey])
  @@index([tenantId])
  @@map("role_assignment_sources")
}

/// An EdunexusAI session that began with an institutional sign-in. Its id travels in the session tokens
/// (`sid`); while it is not ended, the session works. Ending it (portal logout, the provider's back-channel
/// logout, unlinking the identity, disabling the provider) stops the access token on the next request and
/// the refresh token. `idTokenSealed` (AES-256-GCM) is kept only to end the provider session without a
/// confirmation page (id_token_hint).
model SsoSession {
  id            String    @id @default(uuid())
  tenantId      String
  userId        String
  providerId    String
  subject       String
  /// The provider's own session id (ID token "sid"), used by back-channel logout.
  idpSessionId  String?
  idTokenSealed String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  endedAt       DateTime?
  endedReason   String?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, idpSessionId])
  @@index([providerId, subject])
  @@map("sso_sessions")
}

/// Single-use hand-off from the sign-in callback to the browser app. Only the SHA-256 of the code is
/// stored; it is consumed atomically (one conditional update) and expires after 60 seconds. It holds no
/// tokens: the session is issued only when the code is exchanged. Shared by every backend instance.
model SsoHandoff {
  codeHash     String    @id
  tenantId     String
  userId       String
  ssoSessionId String
  returnTo     String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
  @@map("sso_handoffs")
}

/// An institution's own logo, uploaded by its administrators in Portal Appearance (one per institution:
/// kind `logo`). The image file lives in the backend's branding storage directory
/// (BRANDING_STORAGE_DIR); this row keeps only its storage key and metadata. Without a row the portal
/// uses the logo bundled with the deployment. `data` is kept, nullable, only for rows written by the
/// first version of this feature (none exist; new rows never use it).
model TenantBrandAsset {
  id              String   @id @default(uuid())
  tenantId        String
  kind            String
  mimeType        String
  data            Bytes?
  storageKey      String?
  byteSize        Int
  width           Int
  height          Int
  sha256          String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
  @@map("tenant_brand_assets")
}

/// Portal messaging. A conversation has participants and messages; DIRECT conversations have exactly two
/// participants and one row per pair (directKey), so either person reopens the same thread. GROUP and
/// attachments can be added later without changing these tables.
enum ConversationKind {
  DIRECT
}

model Conversation {
  id            String           @id @default(uuid())
  tenantId      String
  kind          ConversationKind @default(DIRECT)
  /// DIRECT only: the two participants' user ids, sorted and joined with ":".
  directKey     String?
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@unique([tenantId, directKey])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  /// Everything this participant received up to here has been read (read receipts and unread counts).
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  /// The sender's own id for the message, so a retried send is stored once.
  clientId       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
