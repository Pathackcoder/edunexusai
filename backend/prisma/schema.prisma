// ===========================================================================
// Cross-persona workflows
//
// One request architecture for every "someone asks, an administrator decides" flow.
// Domain-specific records (ProfileChangeRequest, TranscriptRequest, FormSubmission)
// keep their own tables; a ServiceRequest row links to them through
// sourceType/sourceId so the Admin Operations Workspace sees a single queue and a
// decision is applied back to the domain record in one place (requestService.js).
// ===========================================================================

enum ServiceRequestStatus {
  PENDING
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model ServiceRequest {
  id              String               @id @default(uuid())
  tenantId        String
  reference       String
  requesterUserId String
  requesterRole   RoleKey
  type            String
  category        String
  title           String
  description     String?
  details         Json?
  priority        String               @default("NORMAL")
  status          ServiceRequestStatus @default(PENDING)
  /// Link to a domain record the decision is applied to (PROFILE_CHANGE, TRANSCRIPT, ...).
  sourceType      String?
  sourceId        String?
  decisionNote    String?
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester User                  @relation("RequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  decidedBy User?                 @relation("RequestDecider", fields: [decidedByUserId], references: [id])
  events    ServiceRequestEvent[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([requesterUserId])
  @@index([sourceType, sourceId])
  @@map("service_requests")
}

model ServiceRequestEvent {
  id          String                @id @default(uuid())
  requestId   String
  actorUserId String?
  action      String
  fromStatus  ServiceRequestStatus?
  toStatus    ServiceRequestStatus?
  note        String?
  createdAt   DateTime              @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorUserId], references: [id])

  @@index([requestId, createdAt])
  @@map("service_request_events")
}

model SupportTicket {
  id               String       @id @default(uuid())
  tenantId         String
  reference        String
  requesterUserId  String
  assignedToUserId String?
  category         String
  subject          String
  description      String
  priority         String       @default("NORMAL")
  status           TicketStatus @default(OPEN)
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester  User                   @relation("TicketRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  assignedTo User?                  @relation("TicketAssignee", fields: [assignedToUserId], references: [id])
  messages   SupportTicketMessage[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([requesterUserId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String   @id @default(uuid())
  ticketId     String
  authorUserId String?
  body         String
  isStaffReply Boolean  @default(false)
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// Small supporting documents attached to a request or ticket. Stored in the database
/// for the prototype (size-capped in the service); a production deployment would move
/// `data` to object storage and keep only the key here.
model Attachment {
  id               String   @id @default(uuid())
  tenantId         String
  ownerType        String
  ownerId          String
  fileName         String
  mimeType         String
  sizeBytes        Int
  data             Bytes
