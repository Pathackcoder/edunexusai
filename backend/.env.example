# ---------------------------------------------------------------------------
# EdunexusAI backend — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5001
LOG_LEVEL=dev

# PostgreSQL (DBngin).
# DBngin server "EdunexusAI" (PostgreSQL 18.4) on localhost:5432.
# Database name: edunexusai (tests use edunexusai_test). DBngin's default superuser is
# `postgres` with no password; add `:password` after the user if you set one.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/edunexusai?schema=public"
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/edunexusai_test?schema=public"

# Authentication (prototype JWT). Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# CORS — comma separated. Never "*", because the API is used with credentials.
FRONTEND_URL=http://localhost:5173
# Also the allowed origins of the realtime chat socket (Socket.IO on this same port, path /socket.io).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------

# Mock external university API (stands in for a real SIS/LMS boundary).
MOCK_UNIVERSITY_BASE_URL=http://localhost:5002/external
MOCK_UNIVERSITY_API_KEY=mock-local-api-key
MOCK_UNIVERSITY_TIMEOUT_MS=8000

# Canvas LMS connector.
#   CANVAS_MODE=mock  -> connector runs against the mock external service (default)
#   CANVAS_MODE=live  -> connector calls a real Canvas instance; requires the two
#                        values below. See docs/integrations.md for how to obtain them.
CANVAS_MODE=mock
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
CANVAS_API_VERSION=v1
CANVAS_TIMEOUT_MS=8000

# Banner / Ethos — configuration only. No live connection is implemented.
BANNER_BASE_URL=
BANNER_API_KEY=
ETHOS_BASE_URL=
ETHOS_API_KEY=

# Where course/schedule/assignment/grade reads come from:
#   synced      -> read canonical rows from PostgreSQL (written by connector syncs)
#   passthrough -> call the connector on every request, map, and return (no DB read)
ACADEMIC_READ_MODE=synced

# Moodle LMS (see docs/moodle-integration.md). The token is a Moodle web-service token
# for a dedicated integration user, never an administrator password. Backend only.
MOODLE_BASE_URL=https://your-site.moodlecloud.com
MOODLE_TOKEN=
MOODLE_TIMEOUT_MS=10000
# Bounded retries for read calls only; writes are never retried automatically.
MOODLE_MAX_RETRIES=2
# Master switch for anything that changes Moodle data (create users/courses, enrol).
MOODLE_WRITES_ENABLED=false
# Ids taken from your Moodle site (Site administration). Never guessed by the app.
MOODLE_STUDENT_ROLE_ID=
MOODLE_TEACHER_ROLE_ID=
MOODLE_DEFAULT_CATEGORY_ID=
# Your hosting plan's user-account limit (e.g. MoodleCloud Starter trial: 50). The
# Moodle API cannot report it; the seed refuses to create accounts without it.
MOODLE_SITE_USER_QUOTA=
# How NEW Moodle accounts sign in: manual (a Moodle password, default) or oauth2 (the university sign-in, configured
# in Moodle as an OAuth 2 service against the same Keycloak realm; no Moodle password is created).
MOODLE_ACCOUNT_AUTH=manual
# After a portal account is created at its first institutional sign-in (JIT), also create the person's Moodle account
# and CampusCore-derived enrolments in the background. Needs MOODLE_WRITES_ENABLED=true.
MOODLE_JIT_PROVISIONING=false
# Irreversible course deletion. Leave false.
MOODLE_ALLOW_COURSE_DELETE=false
# Dev seeding guard: `npm run moodle:seed` refuses to run unless this is true.
MOODLE_SEED_ENABLED=false
# Optional demo-only password for seeded Moodle accounts (8+ chars, upper, lower, digit,
# symbol). Never printed or stored by the app. Leave empty to give demo accounts an
# unknown random password instead.
MOODLE_DEMO_PASSWORD=

# CampusCore SIS (see docs/campuscore-integration.md). Server-side only: never expose the
# client secret or tokens to the browser, logs or git. Rotate the secret from CampusCore
# Admin → Developer & integrations if it is ever exposed.
SIS_PROVIDER=campuscore
CAMPUSCORE_BASE_URL=http://localhost:4000
CAMPUSCORE_CLIENT_ID=
CAMPUSCORE_CLIENT_SECRET=
# The CampusCore institution slug these credentials must belong to.
CAMPUSCORE_EXPECTED_INSTITUTION=feddrick
# EduNexusAI's own tenant slug that this SIS connection serves.
SIS_TENANT_KEY=demo-university
CAMPUSCORE_TIMEOUT_MS=10000
# Registry sync: every provisionable CampusCore person gets a portal account (no password; university sign-in)
# without an import. Needs CampusCore's identity.link capability (scope identity:write + policy
# api.allowIdentityLinkWrites). The first pass starts at CAMPUSCORE_ACCOUNT_SYNC_SINCE (ISO instant), or at
# the moment the job first runs, so turning it on never sweeps the historical registry.
CAMPUSCORE_ACCOUNT_SYNC_ENABLED=false
# CAMPUSCORE_ACCOUNT_SYNC_INTERVAL_MS=60000
# CAMPUSCORE_ACCOUNT_SYNC_SINCE=2026-11-04T00:00:00Z

# --- Feddrick CMS (Strapi, feddrick-cms/) -------------------------------------------------
# Server-side only. The browser never sees these; it uses /api/v1/studio and /api/v1/content.
# CMS_API_TOKEN: a Strapi *custom* API token limited to api::edunexus.edunexus.* actions.
CMS_URL=http://127.0.0.1:1338
CMS_ADMIN_URL=http://localhost:1338/admin
CMS_API_TOKEN=
CMS_TIMEOUT_MS=8000
# Apply published Studio dashboard layouts to the live dashboards (off = built-in layouts).
CMS_LAYOUTS_ENABLED=false

# --- Studio form notifications (SMTP) ------------------------------------------------------
# Leave empty to keep form submissions disabled (they are validated, then refused with a clear
# message). Credentials stay on the server; the browser never sees them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Or a single connection string instead of the fields above, e.g. smtps://user:pass@host:465
SMTP_URL=
MAIL_FROM="EduNexusAI Forms <no-reply@your-institution.edu>"
# Optional: only allow notification recipients at these domains (comma-separated).
FORM_RECIPIENT_DOMAINS=

# --- Institutional sign-in (OpenID Connect) ---------------------------------------------------
# One variable per identity provider, named OIDC_CLIENT_SECRET_<NAME>; the provider row (Admin > Sign-in & role
# mapping) refers to it by name. The secret never goes in the database, the frontend or an API response.
# OIDC_CLIENT_SECRET_FEDDRICK=
# Public origin of the portal used to build the callback address (defaults to FRONTEND_URL).
# OIDC_REDIRECT_BASE_URL=http://localhost:5173

# --- Campus Directory (Keycloak Admin REST API, read-only) ------------------------------------
# A dedicated confidential client with ONLY "Service accounts" (client credentials) enabled and the
# realm-management roles view-users + query-users. Never the admin-cli client or an administrator's
# password. See docs/campus-directory.md. Unset = the Campus Directory says it is not connected.
# Base URL as the BACKEND reaches Keycloak (inside Docker use the service name, e.g. http://keycloak:8080).
# KEYCLOAK_DIRECTORY_BASE_URL=http://localhost:8080
# KEYCLOAK_DIRECTORY_REALM=edunexusai-feddrick
# KEYCLOAK_DIRECTORY_CLIENT_ID=edunexusai-directory
# KEYCLOAK_DIRECTORY_CLIENT_SECRET=<client secret from Keycloak: Clients > edunexusai-directory > Credentials>
# The institution (tenant slug) whose members are in this realm; other institutions see "not connected".
# KEYCLOAK_DIRECTORY_TENANT=demo-university
# Optional: the sign-in option whose "Sign-in & role mapping" rules (claim realm_access.roles) label people
# as Student / Faculty / Staff / Alumni. Without it, no role labels are shown.
# KEYCLOAK_DIRECTORY_PROVIDER_KEY=feddrick-sso
# KEYCLOAK_DIRECTORY_TIMEOUT_MS=8000

# CampusCore SIS web app origin; when set, eligible users get an "Open CampusCore SIS" entry.
# CAMPUSCORE_PORTAL_URL=https://sis.example.edu

# Uploaded institution logo (Admin > Portal Appearance). A persistent directory the backend can write,
# outside the code checkout in production (e.g. /var/lib/edunexus/branding). Default: backend/storage/branding.
# BRANDING_STORAGE_DIR=

# Portal usage analytics (Admin > Analytics). See docs/ANALYTICS_DOCUMENTATION.md, section 9.
# Master switch and kill switch for the whole deployment. Off unless "true": nothing is collected and the
# aggregation worker does not start. Read when the API starts, so changing it needs a restart.
# ANALYTICS_ENABLED=false
# Account ids measured even while their institution's own switch is off (a named test account during rollout).
# Needs ANALYTICS_ENABLED. Comma-separated.
# ANALYTICS_ALLOW_USER_IDS=
# Raw visits, page views and events are deleted after this many days (7 to 365).
# ANALYTICS_RAW_RETENTION_DAYS=90
# How often the aggregation worker recalculates the figures, in seconds (30 to 86400).
# ANALYTICS_ROLLUP_INTERVAL_SECONDS=900
